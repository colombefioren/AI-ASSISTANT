# Copy to .env.local for development. Never commit real secrets.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_interview_coach"

# NextAuth: the public URL of the app and a long random secret.
# Generate one with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ElevenLabs Conversational AI. Leave the API key empty to use public agents;
# set it to use private agents through short-lived signed URLs.
ELEVENLABS_API_KEY=""
# Agent ids for each interviewer (defaults to the project's public agents).
ELEVENLABS_AGENT_ID_COCO=""
ELEVENLABS_AGENT_ID_MIMI=""
# Set to "true" only if Overrides are enabled in each agent's Security tab.
# The app then sends its English interviewer prompt and first message.
ELEVENLABS_ALLOW_OVERRIDES="false"

# Set to "true" when running behind a proxy you control that sets
# X-Forwarded-For. Vercel is detected automatically.
TRUST_PROXY="false"
