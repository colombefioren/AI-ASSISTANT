# Copy to .env.local for development. Never commit real secrets.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_interview_coach"
# Direct connection used by migrations. Same as DATABASE_URL unless your host
# pools connections (Neon, Supabase): then use the unpooled URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/ai_interview_coach"

# NextAuth: the public URL of the app and a long random secret.
# Generate one with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ElevenLabs Conversational AI. Leave the API key empty to use public agents;
# set it to use private agents through short-lived signed URLs.
ELEVENLABS_API_KEY=""
# Agent ids for each interviewer (defaults to the project's public agents).
ELEVENLABS_AGENT_ID_COCO=""
ELEVENLABS_AGENT_ID_MIMI=""
# The interview language (FR or EN) is always sent. Set this to "true" only if
# Overrides are enabled in each agent's Security tab: the app then also sends its
# interviewer prompt and first message in the chosen language.
ELEVENLABS_ALLOW_OVERRIDES="false"

# Set to "true" when running behind a proxy you control that sets
# X-Forwarded-For. Vercel is detected automatically.
TRUST_PROXY="false"
